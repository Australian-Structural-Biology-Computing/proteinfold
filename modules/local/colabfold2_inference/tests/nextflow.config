process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    accelerator = 0
    withName: 'COLABFOLD2_INFERENCE' {
        container = ''
    }
    beforeScript = { """
        export PATH='${params.mock_bin}':\$PATH
        unset JAX_COMPILATION_CACHE_DIR
        printf '%s' "${task.containerOptions ?: ''}" > cache-bind.txt
        printf '%s' '${workflow.launchDir.toString().replace("'", "'\\''")}' > cache-launch-dir.txt
    """ }
}
apptainer.enabled = true
singularity.enabled = false
docker.enabled = false
params {
    use_gpu = false
    use_msa_server = false
    colabfold2_kernel_backend = 'auto'
    colabfold2_weights_precision = 'fp32'
    save_intermediates = false
}
includeConfig '../../../../conf/modules_colabfold2.config'
