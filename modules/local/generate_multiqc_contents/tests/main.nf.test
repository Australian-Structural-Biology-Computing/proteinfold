nextflow_process {

    name "Test Process GENERATE_MULTIQC_CONTENTS"
    script "../main.nf"
    process "GENERATE_MULTIQC_CONTENTS"

    tag "modules"
    tag "ci_img_misc"
    tag "modules_local"
    tag "generate_multiqc_contents"
    tag "multiqc"
    profile "test_nostub"

    def testdataBase = System.getenv('PROTEINFOLD_TESTDATA_BASE_PATH') ?: 'https://raw.githubusercontent.com/Australian-Structural-Biology-Computing/test-datasets/refs/heads/proteinfold/'

    // Build the packed metric store pair (<sample>_metrics.jsonl.gz/.npz)
    // from the legacy per-metric TSV fixtures with tests/make_packed_store.py,
    // and return a nextflow expression string for `input[0]`: the nf-test DSL
    // `file()` helper is only in scope inside the generated test script, and
    // the when-block template substitution would swallow closure-local
    // variables, so the stores are built here and only the expression is
    // embedded into the when block.
    // 'rank_<n>=<value>' spec from a two-column (rank, value) TSV fixture;
    // non-numeric rows (the fixtures carry deliberate junk) are skipped.
    def toRankSpec = { String url ->
        new URL(url).text.readLines().findAll { it.trim() }
            .findAll { line -> line.split('\t').every { it.isNumber() } }
            .collect { line -> def parts = line.split('\t'); "rank_${parts[0]}=${parts[1]}" }
            .join(',')
    }

    def buildPackedStore = { String outputDir, String projectDir, String testdata, String sampleId, Map opts = [:] ->
        def plddtLines = new URL(testdata + "testdata/metrics/${opts.plddtFixture}").text.readLines()
        def header = plddtLines[0].split('\t')
        def ranks = (1..header.size() - 1)
        def perRankFiles = ranks.collect { new File(outputDir, "${sampleId}_plddt_${header[it]}.tsv") }
        def perRankValues = ranks.collect { col ->
            plddtLines.tail().collect { it.split('\t')[col] }.findAll { it && it != 'nan' }
        }
        [perRankFiles, perRankValues].transpose().each { f, values -> f.text = values.join('\n') + '\n' }
        def plddtSpec = [ranks.collect { header[it] }, perRankFiles].transpose()
            .collect { rank, f -> "${rank}=${f}" }.join(',')
        def command = [
            'python3', "${projectDir}/tests/make_packed_store.py",
            '--sample-id', sampleId,
            '--out-prefix', "${outputDir}/${sampleId}_colabfold2",
            '--plddt', plddtSpec
        ]
        if (opts.ptmFixture) {
            command += ['--ptm', toRankSpec(testdata + "testdata/metrics/${opts.ptmFixture}")]
            command += ['--iptm', toRankSpec(testdata + "testdata/metrics/${opts.iptmFixture}")]
            command += ['--msa-depth', opts.msaDepth.toString()]
        }
        if (opts.chainwise) {
            // chainwise records stay in the store but must not leak into the
            // MultiQC contents
            command += ['--chainwise-iptm', 'rank_0=A:B=0.1']
        }
        def generator = command.execute()
        assert generator.waitFor() == 0 : generator.err.text
        // Return the complete when-block script with the real paths baked in:
        // keeping every ${...} out of the when template sidesteps the nf-test
        // variable substitution, which mangles closure values.
        "input[0] = tuple([model: '${opts.model}'], " +
            "[file('${outputDir}/${sampleId}_colabfold2_metrics.jsonl.gz', checkIfExists: true), " +
            "file('${outputDir}/${sampleId}_colabfold2_metrics.npz', checkIfExists: true)])\n" +
            "input[1] = file('${projectDir}/modules/local/generate_multiqc_contents/generate_multiqc_contents.py', checkIfExists: true)"
    }

    test("generates mode-qualified general stats and rank rows (boltz shape)") {

        when {
            process {
                def msaDepth = new URL(testdataBase + 'testdata/metrics/S2_boltz_msa.tsv').text.readLines().findAll { it.trim() }.size()
                buildPackedStore(outputDir, projectDir, testdataBase, 'S2', [
                    model: 'boltz',
                    plddtFixture: 'S2_plddt.tsv',
                    ptmFixture: 'S2_ptm.tsv',
                    iptmFixture: 'S2_iptm.tsv',
                    msaDepth: msaDepth,
                    chainwise: true
                ])
            }
        }

        then {
            def jsonSlurper = new groovy.json.JsonSlurper()
            def outs = process.out.mqc_json[0][1]
def files = (outs instanceof List ? outs : [outs]).collect { file(it) }
            def generalstats = jsonSlurper.parse(files.find { it.toString().contains('generalstats') })
            def linegraph = jsonSlurper.parse(files.find { it.toString().contains('plddt_lineplot') })
            def near = { value, expected -> Math.abs(value - expected) < 1e-9 }
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.mqc_json).match() },
                {
                    assert generalstats.data.keySet() ==
                        ['S2_Boltz', 'S2_Boltz_rank_1', 'S2_Boltz_rank_2'] as Set
                    assert near(generalstats.data['S2_Boltz'].mean_plddt, 88.23333333333333)
                    assert generalstats.data['S2_Boltz'].msa_depth == 3
                    assert near(generalstats.data['S2_Boltz'].iptm, 0.83)
                    assert near(generalstats.data['S2_Boltz_rank_1'].mean_plddt, 80.76666666666667)
                    assert generalstats.headers.keySet() == ['msa_depth', 'mean_plddt', 'iptm', 'ptm'] as Set
                },
                {
                    assert files.size() == 2
                    assert linegraph.plot_type == 'linegraph'
                    assert linegraph.pconfig.ymax == 100
                    assert linegraph.pconfig.data_labels == [[name: 'S2_Boltz', ylab: 'pLDDT score']]
                    assert linegraph.data.size() == 1
                    assert linegraph.data[0].keySet() == ['rank_0', 'rank_1', 'rank_2'] as Set
                    assert linegraph.data[0]['rank_0'] == [[1, 88.0], [2, 87.5], [3, 89.2]]
                    assert linegraph.data[0]['rank_2'] == [[1, 71.5], [2, 72.3]]
                    assert !files.find { it.toString().contains('generalstats') }.text.contains('NaN')
                    assert !files.find { it.toString().contains('generalstats') }.text.contains('Infinity')
                },
                {
                    def raw = (files.collect { it.text }).join('\n')
                    assert !raw.contains('pae')
                    assert !raw.contains('chainwise')
                    assert !raw.contains('UNKNOWN')
                }
            )
        }
    }

    test("generates a single-rank row without extra columns (esmfold shape)") {

        when {
            process {
                buildPackedStore(outputDir, projectDir, testdataBase, 'S1', [
                    model: 'esmfold',
                    plddtFixture: 'S1_plddt.tsv'
                ])
            }
        }

        then {
            def jsonSlurper = new groovy.json.JsonSlurper()
            def outs = process.out.mqc_json[0][1]
def files = (outs instanceof List ? outs : [outs]).collect { file(it) }
            def generalstats = jsonSlurper.parse(files.find { it.toString().contains('generalstats') })
            def linegraph = jsonSlurper.parse(files.find { it.toString().contains('plddt_lineplot') })
            assertAll(
                { assert process.success },
                {
                    assert generalstats.data.keySet() == ['S1_ESMFold'] as Set
                    assert Math.abs(generalstats.data['S1_ESMFold'].mean_plddt - 92.33333333333333) < 1e-9
                    assert generalstats.headers.keySet() == ['mean_plddt'] as Set
                    assert !generalstats.data['S1_ESMFold'].containsKey('msa_depth')
                    assert files.size() == 2
                    assert linegraph.data.size() == 1
                    assert linegraph.pconfig.data_labels[0].name == 'S1_ESMFold'
                    assert linegraph.data[0]['rank_0'] == [[1, 92.2], [2, 91.8], [3, 93.0]]
                }
            )
        }
    }
}
