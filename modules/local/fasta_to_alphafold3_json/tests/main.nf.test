nextflow_process {

    name "Test Process FASTA_TO_ALPHAFOLD3_JSON"
    script "../main.nf"
    process "FASTA_TO_ALPHAFOLD3_JSON"

    tag "modules"
    tag "modules_local"
    tag "cpu"
    tag "real"
    tag "fasta_to_alphafold3_json"
    profile "test_nostub"

    test("converts a mixed-entity FASTA to AlphaFold3 JSON") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'mixed_sample' ],
                    file("${projectDir}/tests/fixtures/modules/local/cpu/multichain.fasta", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def result = new groovy.json.JsonSlurper().parse(path(process.out.json[0][1]).toFile())
            assertAll(
                { assert process.success },
                { assert result.name == 'mixed_sample' },
                { assert result.modelSeeds == [11] },
                { assert result.dialect == 'alphafold3' },
                { assert result.version == 1 },
                { assert result.sequences == [
                    [ protein: [ id: 'A', sequence: 'MKTAYI' ] ],
                    [ dna: [ id: 'B', sequence: 'ACGT' ] ],
                    [ rna: [ id: 'C', sequence: 'ACGU' ] ]
                ] },
                { assert process.out.versions }
            )
        }
    }
}
