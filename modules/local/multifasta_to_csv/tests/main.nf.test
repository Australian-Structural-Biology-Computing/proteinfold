nextflow_process {

    name "Test Process MULTIFASTA_TO_CSV"
    script "../main.nf"
    process "MULTIFASTA_TO_CSV"

    tag "modules"
    tag "modules_local"
    tag "cpu"
    tag "real"
    tag "multifasta_to_csv"
    profile "test_nostub"

    test("converts a multi-FASTA to a ColabFold CSV") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'mixed_sample' ],
                    file("${projectDir}/tests/fixtures/modules/local/cpu/multichain.fasta", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.input_csv[0][1]).text == "id,sequence\nmixed_sample,MKTAYI:ACGT:ACGU\n" },
                { assert process.out.versions }
            )
        }
    }
}
