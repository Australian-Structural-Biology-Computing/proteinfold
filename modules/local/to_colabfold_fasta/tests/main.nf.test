nextflow_process {

    name "Test Process TO_COLABFOLD_FASTA"
    script "../main.nf"
    process "TO_COLABFOLD_FASTA"

    tag "modules"
    tag "modules_local"
    tag "to_colabfold_fasta"
    profile "test_nostub"

    setup {
        // tests/data is gitignored, so the fixtures are written here
        file("$outputDir/to_colabfold_fasta").mkdirs()
        file("$outputDir/to_colabfold_fasta/multichain.fasta").text =
            '>sample_alpha\nMKTAYIAKQRQISFVKSH\n>sample_beta\nEVLQQNSEIL\n'
        file("$outputDir/to_colabfold_fasta/second.fasta").text =
            '>second_sample\nAAAA\n'
        file("$outputDir/to_colabfold_fasta/rich_input.json").text =
            '''{
  "dialect": "alphafold3",
  "version": 2,
  "name": "rich_sample",
  "sequences": [
    {
      "protein": {
        "id": ["A", "D"],
        "sequence": "ACDE",
        "modifications": [{"ptmType": "CCD_SEP", "ptmPosition": 2}],
        "templates": []
      }
    },
    {"rna": {"id": "B", "sequence": "AUCG", "modifications": []}},
    {"ligand": {"id": "C", "smiles": "CCO"}}
  ],
  "modelSeeds": [1],
  "bondedAtomPairs": [[[["A", 1, "CA"], ["C", 1, "C1"]]]],
  "userCCD": "data_custom\\n#"
}
'''
    }

    test("concatenates converted queries into pre-batched chunk FASTAs") {
        def fastaInput = new File("$outputDir/to_colabfold_fasta/multichain.fasta").absolutePath

        when {
            process {
                """
                input[0] = [
                    [ [ [ id: 'sample' ], file('${fastaInput}', checkIfExists: true) ] ],
                    [ file('${fastaInput}', checkIfExists: true) ]
                ]
                input[1] = -1
                input[2] = false
                """
            }
        }

        then {
            def asList = { value -> value instanceof List ? value : [value] }
            assertAll(
                { assert process.success },
                { assert path(asList(process.out.chunks[0][1])[0].toString()).text == '>sample\nMKTAYIAKQRQISFVKSH:EVLQQNSEIL\n' },
                                { assert !process.out.queries }
            )
        }
    }

    test("splits misses into one chunk per msa_batch_size records") {
        def fastaInput = new File("$outputDir/to_colabfold_fasta/multichain.fasta").absolutePath
        def secondInput = new File("$outputDir/to_colabfold_fasta/second.fasta").absolutePath

        when {
            process {
                """
                input[0] = [
                    [ [ [ id: 'sample' ], file('${fastaInput}', checkIfExists: true) ], [ [ id: 'second' ], file('${secondInput}', checkIfExists: true) ] ],
                    [ file('${fastaInput}', checkIfExists: true), file('${secondInput}', checkIfExists: true) ]
                ]
                input[1] = 1
                input[2] = false
                """
            }
        }

        then {
            def asList = { value -> value instanceof List ? value : [value] }
            assertAll(
                { assert process.success },
                { assert asList(process.out.chunks[0][1]).size() == 2 },
                { assert asList(process.out.chunks[0][1]).collect { f -> path(f.toString()).text }.contains('>sample\nMKTAYIAKQRQISFVKSH:EVLQQNSEIL\n') },
                { assert asList(process.out.chunks[0][1]).collect { f -> path(f.toString()).text }.contains('>second\nAAAA\n') },
            )
        }
    }

    test("keeps one query FASTA per sample when emit_queries is set") {
        def fastaInput = new File("$outputDir/to_colabfold_fasta/multichain.fasta").absolutePath

        when {
            process {
                """
                input[0] = [
                    [ [ [ id: 'sample' ], file('${fastaInput}', checkIfExists: true) ] ],
                    [ file('${fastaInput}', checkIfExists: true) ]
                ]
                input[1] = -1
                input[2] = true
                """
            }
        }

        then {
            def asList = { value -> value instanceof List ? value : [value] }
            assertAll(
                { assert process.success },
                { assert path(asList(process.out.queries[0][1])[0].toString()).text == '>sample\nMKTAYIAKQRQISFVKSH:EVLQQNSEIL\n' },
                { assert !process.out.chunks }
            )
        }
    }

    test("extracts repeated protein queries without flattening rich AF3 entities") {
        def richInput = new File("$outputDir/to_colabfold_fasta/rich_input.json").absolutePath

        when {
            process {
                """
                input[0] = [
                    [ [ [ id: 'rich_sample' ], file('${richInput}', checkIfExists: true) ] ],
                    [ file('${richInput}', checkIfExists: true) ]
                ]
                input[1] = -1
                input[2] = false
                """
            }
        }

        then {
            def asList = { value -> value instanceof List ? value : [value] }
            assertAll(
                { assert process.success },
                { assert path(asList(process.out.chunks[0][1])[0].toString()).text == '>rich_sample\nACDE:ACDE\n' },
            )
        }
    }
}
