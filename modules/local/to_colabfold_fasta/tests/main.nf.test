nextflow_process {

    name "Test Process TO_COLABFOLD_FASTA"
    script "../main.nf"
    process "TO_COLABFOLD_FASTA"

    tag "modules"
    tag "modules_local"
    tag "to_colabfold_fasta"
    profile "test_nostub"

    setup {
        // tests/data is gitignored, so the fixtures are written here
        file("$outputDir/to_colabfold_fasta").mkdirs()
        file("$outputDir/to_colabfold_fasta/multichain.fasta").text =
            '>sample_alpha\nMKTAYIAKQRQISFVKSH\n>sample_beta\nEVLQQNSEIL\n'
        file("$outputDir/to_colabfold_fasta/rich_input.json").text =
            '''{
  "dialect": "alphafold3",
  "version": 2,
  "name": "rich_sample",
  "sequences": [
    {
      "protein": {
        "id": ["A", "D"],
        "sequence": "ACDE",
        "modifications": [{"ptmType": "CCD_SEP", "ptmPosition": 2}],
        "templates": []
      }
    },
    {"rna": {"id": "B", "sequence": "AUCG", "modifications": []}},
    {"ligand": {"id": "C", "smiles": "CCO"}}
  ],
  "modelSeeds": [1],
  "bondedAtomPairs": [[[["A", 1, "CA"], ["C", 1, "C1"]]]],
  "userCCD": "data_custom\\n#"
}
'''
    }

    test("colon-joins a multi-record FASTA into one ColabFold query") {
        def fastaInput = new File("$outputDir/to_colabfold_fasta/multichain.fasta").absolutePath

        when {
            process {
                """
                input[0] = [
                    [ id: 'sample' ],
                    file('${fastaInput}', checkIfExists: true)
                ]
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.query[0][1]).text == '>sample\nMKTAYIAKQRQISFVKSH:EVLQQNSEIL\n' }
            )
        }
    }

    test("extracts repeated protein queries without flattening rich AF3 entities") {
        def richInput = new File("$outputDir/to_colabfold_fasta/rich_input.json").absolutePath

        when {
            process {
                """
                input[0] = [
                    [ id: 'rich_sample' ],
                    file('${richInput}', checkIfExists: true)
                ]
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.query[0][1]).text == '>rich_sample\nACDE:ACDE\n' }
            )
        }
    }
}
