nextflow_process {

    name "Test Process TO_COLABFOLD_FASTA"
    script "../main.nf"
    process "TO_COLABFOLD_FASTA"

    tag "modules"
    tag "modules_local"
    tag "to_colabfold_fasta"
    profile "test_nostub"

    test("colon-joins a multi-record FASTA into one ColabFold query") {
        def fastaInput = new File('modules/local/to_colabfold_fasta/tests/data/multichain.fasta').absolutePath

        when {
            process {
                """
                input[0] = [
                    [ id: 'sample' ],
                    file('${fastaInput}', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.query_fasta[0][1]).text == '>sample\nMKTAYIAKQRQISFVKSH:EVLQQNSEIL\n' }
            )
        }
    }

    test("extracts repeated protein queries without flattening rich AF3 entities") {
        def richInput = new File('modules/local/to_colabfold_fasta/tests/data/rich_input.json').absolutePath

        when {
            process {
                """
                input[0] = [
                    [ id: 'rich_sample' ],
                    file('${richInput}', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.query_fasta[0][1]).text == '>rich_sample\nACDE:ACDE\n' }
            )
        }
    }
}
