nextflow_process {
    name "Test Process GENERATE_REPORT_BATCH"
    script "../main.nf"
    process "GENERATE_REPORT_BATCH"
    tag "modules"
    tag "ci_img_misc"
    tag "modules_local"
    tag "generate_report"
    tag "security"

    profile "test_nostub"

    // Build a packed metric store pair from the legacy per-rank TSV fixtures
    // (same approach as tests/assemble_modelcif.nf.test).
    def testdataBase = System.getenv('PROTEINFOLD_TESTDATA_BASE_PATH') ?: 'https://raw.githubusercontent.com/Australian-Structural-Biology-Computing/test-datasets/refs/heads/proteinfold/'

    def buildInputs = { outputDir, projectDir, testdata ->
        // Extract per-rank pLDDT columns from the DUMMY_PLDDT matrix the same
        // way tests/assemble_modelcif.nf.test does.
        def plddtLines = new URL(testdataBase + 'testdata/metrics/DUMMY_PLDDT.tsv').readLines()
        def column = plddtLines[0].split('\t').findIndexOf { it == 'rank_0' }
        new File(outputDir, 'S1_plddt_0.tsv').text = plddtLines.tail()
            .collect { it.split('\t')[column] }.join('\n') + '\n'
        def pae = new File(projectDir, 'tests/fixtures/DUMMY_PAE.tsv').text
        new File(outputDir, 'S1_pae_0.tsv').text = pae
        new File(outputDir, 'S1.a3m').text = '>S1\n' + ('A' * 20) + '\n'
        def generator = [
            'python3', "$projectDir/tests/make_packed_store.py",
            '--sample-id', 'S1',
            '--out-prefix', "$outputDir/S1",
            '--plddt', "rank_0=$outputDir/S1_plddt_0.tsv",
            '--pae', "rank_0=$outputDir/S1_pae_0.tsv",
            '--scores', 'rank_0=0.725'
        ].execute()
        assert generator.waitFor() == 0 : generator.err.text
        // colabfold-style ranked-structure names: the generator globs
        // <sample_id>_rank_*.<struct-ext>.
        (0..1).each { rank ->
            def src = new URL(testdataBase + "testdata/models/rank_${rank}.pdb").bytes
            new File(outputDir, "S1_rank_${rank}.pdb").bytes = src
        }
        [
            "[[id: 'S1', model: 'alphafold2', mode_short: 'af2', msa_short: 'mmseqs', msa_tool: 'jackhmmer']]",
            "[file('${outputDir}/S1_rank_0.pdb', checkIfExists: true), file('${outputDir}/S1_rank_1.pdb', checkIfExists: true)]",
            "[file('${outputDir}/S1.a3m', checkIfExists: true)]",
            "[file('${outputDir}/S1_metrics.jsonl.gz', checkIfExists: true), file('${outputDir}/S1_metrics.npz', checkIfExists: true)]",
            "S1\\tS1_metrics.jsonl.gz\\tS1_metrics.npz\\taf2_mmseqs",
            'pdb'
        ]
    }

    test("report generation carries full config, injection-safe blob, and clean download naming") {
        when {
            process {
                def testdata = params.pipelines_testdata_base_path
                def inputs = buildInputs(outputDir, projectDir, testdata)
                """
                input[0] = tuple(${inputs[0]}, ${inputs[1]}, ${inputs[2]}, ${inputs[3]}, '${inputs[4]}', '${inputs[5]}')
                input[1] = file("${projectDir}/assets/report_template.html", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            def html = path(process.out.report[0][1]).text
            def matcher = html =~ /(?s)<script type="application\/json" id="report-config">(.*?)<\/script>/
            assert matcher.count == 1
            def config = new groovy.json.JsonSlurper().parseText(matcher[0][1])
            assert config.programName == "AlphaFold2"
            assert config.sampleName == "S1"
            assert config.structFormat == "cif"
            assert config.models == ["S1_rank_0.cif", "S1_rank_1.cif"]
            assert config.models_data.size() == 2 && config.models_data.every { it.contains("_atom_site.group_PDB") }
            assert config.lddt_averages.size() == 2
            assert config.iptm_scores == ["0.725", "n/a"] && config.ipsae_scores == ["n/a", "n/a"]
            assert !html.contains("<img src=x onerror=alert(1)>")
            assert !((html =~ /(?s)const renderScoreMatrix = .*?const updatePairScoreTables/)[0]).contains("innerHTML")
            assert html.contains('onclick="downloadStructure()"') && !html.contains("downloadPdb")
            assert html.contains('id="structure-download-label"') && html.contains('structure-download-label").textContent')
            assert (html =~ /image\.id =/).count == 1
            def downloader = (html =~ /(?s)const downloadStructure = .*?const makeDownload/)[0]
            assert downloader.contains("MODELS[state.model]")
            assert !downloader.contains(".cif.cif") && !downloader.contains("SAMPLE_NAME")
            assert html.contains("const modelLabel = ")
        }
    }
}
