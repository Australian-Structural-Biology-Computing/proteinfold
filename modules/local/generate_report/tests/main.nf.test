nextflow_process {
    name "Test Process GENERATE_REPORT"
    script "../main.nf"
    process "GENERATE_REPORT"
    tag "modules"
    tag "ci_img_misc"
    tag "modules_local"
    tag "generate_report"
    tag "security"

    profile "test_nostub"

    test("report generation carries full config, injection-safe blob, and clean download naming") {
        when {
            process {
                """
                input[0] = tuple(
                    [id: 'S1', model: 'boltz2', mode_short: 'bz2'],
                    [file(params.pipelines_testdata_base_path + 'testdata/models/rank_0.pdb', checkIfExists: true), file(params.pipelines_testdata_base_path + 'testdata/models/rank_1.pdb', checkIfExists: true)],
                    [file("${projectDir}/tests/fixtures/NO_FILE")],
                    [file("${projectDir}/tests/fixtures/NO_FILE")],
                    [file(params.pipelines_testdata_base_path + 'testdata/metrics/S1_scalar.tsv', checkIfExists: true)],
                    [file(params.pipelines_testdata_base_path + 'testdata/metrics/S1_scalar.tsv', checkIfExists: true)],
                    [file(params.pipelines_testdata_base_path + 'testdata/metrics/S1_chainwise.tsv', checkIfExists: true)],
                    [file("${projectDir}/tests/fixtures/NO_FILE")],
                    [file("${projectDir}/tests/fixtures/entities_empty.json", checkIfExists: true)]
                )
                input[1] = file("${projectDir}/assets/report_template.html", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            def html = path(process.out.report[0][1]).text
            def matcher = html =~ /(?s)<script type="application\/json" id="report-config">(.*?)<\/script>/
            assert matcher.count == 1
            def config = new groovy.json.JsonSlurper().parseText(matcher[0][1])
            assert config.programName == "Boltz2"
            assert config.sampleName == "S1"
            // Only the top-ranked structure is embedded, in its original format
            assert config.model == "rank_0.pdb"
            assert config.structFormat == "pdb"
            assert config.modelData.count("ATOM") >= 1 && !config.modelData.contains("rank_1")
            assert config.plddtAverage == 80.5 || config.plddtAverage instanceof Number
            assert config.iptmScore == "0.725" && config.ipsaeScore == "0.725"
            def payload = "</script><img src=x onerror=alert(1)>"
            assert config.chainwise.chains.contains(payload)
            assert config.chainwise_ipsae.chains == []
            assert !html.contains("<img src=x onerror=alert(1)>")
            assert !((html =~ /(?s)const renderScoreMatrix = .*?const buildInteractivePanels/)[0]).contains("innerHTML")
            // The viewer's custom floating action buttons (reset view,
            // download) were dropped in favour of Molstar's own controls
            assert !html.contains("downloadStructure") && !html.contains("makeDownload")
            // Molstar-based viewer with cross-highlighting scaffolding
            assert config.residues && config.residues[0][0] == "A"
            assert config.pae == null && config.msa == null
            // The empty entity map keeps the entity colouring hidden
            assert config.entities == []
            assert html.contains("cdn.jsdelivr.net/npm/molstar@") && !html.contains("ngl.js") && !html.contains("NGL.Stage")
            assert html.contains("id=\"molstar-root\"")
            assert html.contains("id=\"selection-readout\"")
            assert html.contains("id=\"sequence-root\"")
            assert html.contains("structureInteractivity")
            // SBP-portal-style layout: no per-model carousel, no pLDDT trace
            assert !html.contains("canvas_button_container") && !html.contains("plotly")
            assert html.contains("scores-banner") && html.contains("pLDDT colour legend")
            // Chainwise scores overlay on the PAE blocks via a colouring toggle
            assert html.contains("matrix-mode-toggle") && html.contains("drawScoreBlocks")
            // Ligand tokens flagged so the PAE axes give them fixed lanes
            assert config.residues.every { it.size() == 5 }
            // Structure colouring toggle (pLDDT bins vs shared chain palette)
            assert html.contains("color-mode-toggle") && html.contains("chain-element")
        }
    }
}
