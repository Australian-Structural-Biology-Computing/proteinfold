nextflow_process {

    name "Test Process RUN_ALPHAFOLD2_PRED"
    script "../main.nf"
    process "RUN_ALPHAFOLD2_PRED"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "run_alphafold2_pred"
    tag "alphafold2"
    tag "gpu"
    tag "real"
    profile "test_nostub"
    profile "gpu"

    test("predicts an AlphaFold2 structure from validated CPU features") {
        when {
            process {
                """
                def db = System.getenv('PROTEINFOLD_TEST_DB')
                assert db: 'PROTEINFOLD_TEST_DB must point to the ProteinFold microDB root'

                def featuresPath = System.getenv('PROTEINFOLD_AF2_FEATURES')
                assert featuresPath: 'PROTEINFOLD_AF2_FEATURES must point to validated RUN_ALPHAFOLD2_MSA features.pkl'
                def features = file(featuresPath, checkIfExists: true)
                def featuresSha256 = java.security.MessageDigest
                    .getInstance('SHA-256')
                    .digest(features.bytes)
                    .encodeHex()
                    .toString()
                assert featuresSha256 == '212cb501978f2a93fab1c91b071a8329d92cc763efeb69b08a47caf6ad2449e5'

                def unusedDb = file('unused_db')
                unusedDb.text = 'Inference consumes the validated CPU artifact, not these database inputs.'
                def unusedMmcif = file('unused_mmcif')
                unusedMmcif.mkdirs()
                file('unused_mmcif/README').text = 'Not used during inference.'

                def paramsPattern = db.startsWith('s3://') ?
                    "${db}/params/alphafold_params_2022-12-06/*" :
                    "${db}/params/alphafold_params/*"

                input[0] = [[id: 'ubiquitin'], file("${projectDir}/tests/fixtures/ubiquitin.fasta", checkIfExists: true), features, 'monomer_ptm']
                input[1] = files(paramsPattern, checkIfExists: true)
                input[2] = unusedDb
                input[3] = unusedDb
                input[4] = unusedDb
                input[5] = unusedDb
                input[6] = unusedMmcif
                input[7] = unusedDb
                input[8] = unusedDb
                input[9] = unusedDb
                input[10] = unusedDb
                input[11] = unusedDb
                """
            }
        }

        then {
            def topRanked = path(process.out.top_ranked_pdb[0][1])
            def plddt = path(process.out.multiqc[0][1])
            assertAll(
                { assert process.success },
                { assert process.out.top_ranked_pdb[0][0].id == 'ubiquitin' },
                { assert topRanked.size() > 0 },
                { assert topRanked.text.contains('ATOM') },
                { assert plddt.size() > 0 },
                { assert process.out.versions }
            )
        }
    }
}
