nextflow_process {

    name "Test Process MMSEQS_COLABFOLDSEARCH_BATCH"
    script "../main.nf"
    process "MMSEQS_COLABFOLDSEARCH_BATCH"
    profile "test"

    tag "modules"
    tag "ci_img_cf"
    tag "modules_local"
    tag "mmseqs_colabfoldsearch"

    test("batches ColabFold search inputs and preserves sample IDs") {

        options "-stub"

        when {
            process {
                """
                def dbDir = file('db')
                dbDir.mkdirs()
                file('db/dummy.db').text = 'x'

                def unirefDir = file('uniref30')
                unirefDir.mkdirs()
                file('uniref30/dummy.db').text = 'x'

                // The converter emits one concatenated query per
                // msa_batch_size slice; the search consumes it directly.
                def query = file('queries_0.fasta')
                query.text = '>T1024\\nMKTAYIAKQRQISFVKSHFSRQDILD\\n>T1026\\nGIVLDSGDGVTHVVPI\\n'

                input[0] = [
                    [[id: 'T1024'], [id: 'T1026']],
                    query
                ]
                input[1] = file('db/*')
                input[2] = file('uniref30/*')
                """
            }
        }

        then {
            assert process.success
            // Run with a container profile so the version evals report the
            // real image's versions.
            assert snapshot(process.out).match()
        }
    }
}
