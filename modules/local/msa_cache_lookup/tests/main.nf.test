nextflow_process {
    name "Boltz MSA cache lookup stub"
    script "../main.nf"
    process "MSA_CACHE_LOOKUP"

    test("cache miss") {
        when {
            params {
                boltz_msa_cache_dir = "$outputDir/cache"
                boltz_msa_cache_id = "revision"
                boltz_msa_cache_tool_id = "sha256:test-image"
            }
            process {
                """
                input[0] = [[id: 'sample'], file(projectDir + '/modules/local/msa_cache_lookup/tests/query.fasta', checkIfExists: true)]
                """
            }
        }
        then {
            assert process.success
            assert !file("${process.out[0][0][2]}/hit.json").exists()
        }
    }

    test("cache hit") {
        when {
            params {
                mode = 'boltz'
                colabfold_db_load_mode = 1
                boltz_msa_cache_dir = "$outputDir/cache"
                boltz_msa_cache_id = "revision"
                boltz_msa_cache_tool_id = "sha256:test-image"
            }
            process {
                """
                def fasta = file(projectDir + '/modules/local/msa_cache_lookup/tests/query.fasta', checkIfExists: true)
                def cacheDir = file(params.boltz_msa_cache_dir)
                cacheDir.mkdirs()
                def payload = file(projectDir + '/modules/local/msa_cache_lookup/tests/multimer.json', checkIfExists: true)
                def a3mPayload = file("$outputDir/alignment.a3m")
                a3mPayload.text = '#4\\t1\\n#1\\t1\\t1\\n>query\\nACDE\\n>other\\nAcD-E\\n'
                def helper = file(projectDir + '/bin/msa_cache.py')
                assert ['python3', helper.toString(), 'store', fasta.toString(), 'revision', 'sha256:test-image', '--db-load-mode 1', cacheDir.toString(), payload.toString(), a3mPayload.toString()].execute().waitFor() == 0
                input[0] = [[id: 'sample'], fasta]
                """
            }
        }
        then {
            assert process.success
            def hitJson = file("${process.out[0][0][2]}/hit.json")
            assert hitJson.exists()
            assert hitJson.bytes == file(projectDir + '/modules/local/msa_cache_lookup/tests/multimer.json').bytes
            def bundles = file(params.boltz_msa_cache_dir).listFiles().findAll { it.name.endsWith('.zip') }
            assert bundles.size() == 1
            def archive = new java.util.zip.ZipFile(bundles[0])
            try {
                assert archive.entries().toList()*.name.sort() == ['alignment.a3m', 'alignment.json']
            } finally {
                archive.close()
            }
            def fasta = file(projectDir + '/modules/local/msa_cache_lookup/tests/query.fasta')
            def hitA3m = file("$outputDir/hit.a3m")
            assert ['python3', file(projectDir + '/bin/msa_cache.py').toString(), 'lookup', fasta.toString(), 'revision', 'sha256:test-image', '--db-load-mode 1', params.boltz_msa_cache_dir.toString(), hitA3m.toString(), 'a3m'].execute().waitFor() == 0
            assert hitA3m.bytes == file("$outputDir/alignment.a3m").bytes
        }
    }

    test("missing JSON member misses while A3M remains usable") {
        when {
            params {
                boltz_msa_cache_dir = "$outputDir/cache"
                boltz_msa_cache_id = "revision"
                boltz_msa_cache_tool_id = "sha256:test-image"
            }
            process {
                """
                def fasta = file(projectDir + '/modules/local/msa_cache_lookup/tests/query.fasta', checkIfExists: true)
                def cacheDir = file(params.boltz_msa_cache_dir)
                cacheDir.mkdirs()
                def payload = file(projectDir + '/modules/local/msa_cache_lookup/tests/multimer.json', checkIfExists: true)
                def a3mPayload = file("$outputDir/alignment.a3m")
                a3mPayload.text = '>query\\nACDE\\n'
                def helper = file(projectDir + '/bin/msa_cache.py')
                assert ['python3', helper.toString(), 'store', fasta.toString(), 'revision', 'sha256:test-image', '', cacheDir.toString(), payload.toString(), a3mPayload.toString()].execute().waitFor() == 0
                def bundle = cacheDir.listFiles().find { it.name.endsWith('.zip') }
                new java.util.zip.ZipOutputStream(new FileOutputStream(bundle.toFile())).withCloseable { archive ->
                    archive.putNextEntry(new java.util.zip.ZipEntry('alignment.a3m'))
                    archive.write(a3mPayload.bytes)
                    archive.closeEntry()
                }
                input[0] = [[id: 'sample'], fasta]
                """
            }
        }
        then {
            assert process.success
            assert !file("${process.out[0][0][2]}/hit.json").exists()
            def fasta = file(projectDir + '/modules/local/msa_cache_lookup/tests/query.fasta')
            def hitA3m = file("$outputDir/hit.a3m")
            assert ['python3', file(projectDir + '/bin/msa_cache.py').toString(), 'lookup', fasta.toString(), 'revision', 'sha256:test-image', '', params.boltz_msa_cache_dir.toString(), hitA3m.toString(), 'a3m'].execute().waitFor() == 0
            assert hitA3m.bytes == file("$outputDir/alignment.a3m").bytes
        }
    }

    test("corrupt cache misses") {
        when {
            params {
                boltz_msa_cache_dir = "$outputDir/cache"
                boltz_msa_cache_id = "revision"
                boltz_msa_cache_tool_id = "sha256:test-image"
            }
            process {
                """
                def fasta = file(projectDir + '/modules/local/msa_cache_lookup/tests/query.fasta', checkIfExists: true)
                def cacheDir = file(params.boltz_msa_cache_dir)
                cacheDir.mkdirs()
                def payload = file(projectDir + '/modules/local/msa_cache_lookup/tests/multimer.json', checkIfExists: true)
                def a3mPayload = file("$outputDir/alignment.a3m")
                a3mPayload.text = '>query\\nACDEFG\\n'
                def helper = file(projectDir + '/bin/msa_cache.py')
                assert ['python3', helper.toString(), 'store', fasta.toString(), 'revision', 'sha256:test-image', '', cacheDir.toString(), payload.toString(), a3mPayload.toString()].execute().waitFor() == 0
                cacheDir.listFiles().find { it.name.endsWith('.zip') }.text = '{"sequences":[]}'
                input[0] = [[id: 'sample'], fasta]
                """
            }
        }
        then {
            assert process.success
            assert !file("${process.out[0][0][2]}/hit.json").exists()
        }
    }
}
