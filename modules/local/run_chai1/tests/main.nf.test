nextflow_process {

    name "Test Process RUN_CHAI1"
    script "../main.nf"
    process "RUN_CHAI1"

    tag "modules"
    tag "modules_local"
    tag "run_chai1"

    test("fasta - stub") {

        options "-stub"

        when {
            process {
                """
                def fasta = file('test.fasta')
                fasta.text = '>test\\nMKTAYIAKQRQISFVKSHFSRQDILD\\n'

                input[0] = [
                    [ id: 'test' ],
                    fasta,
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.top_ranked_pdb.get(0).get(1).toString().endsWith('test_chai1.cif') },
                { assert process.out.multiqc.get(0).get(1).toString().endsWith('test_plddt_mqc.tsv') }
            )
        }

    }

}
