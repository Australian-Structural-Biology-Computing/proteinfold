nextflow_pipeline {

    name "Test boltz mode stub"
    script "../main.nf"
    tag "pipeline"
    tag "ci_img_boltz"
    tag "test_boltz"
    profile "test_boltz"

    test("default cache directory runs lookup and MMSEQS") {
        when {
            params {
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.succeeded().any { it.name.contains('MSA_CACHE_LOOKUP') }
            assert workflow.trace.succeeded().any { it.name.contains('MMSEQS_COLABFOLDSEARCH') }
            assert workflow.trace.succeeded().count { it.name.contains('MSA_CACHE_LOOKUP') } == 2
        }
    }

    test("cache miss runs MMSEQS") {
        when {
            params {
                outdir = "$outputDir"
                boltz_msa_cache_dir = "$outputDir/cache"
                boltz_msa_cache_id = "revision"
                boltz_msa_cache_tool_id = "sha256:test-image"
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.succeeded().any { it.name.contains('MMSEQS_COLABFOLDSEARCH') }
            assert workflow.trace.succeeded().any { it.name.contains('MSA_CACHE_LOOKUP') }
        }
    }

    test("multimer cache hit skips MMSEQS and reaches splitter") {
        setup {
                def cacheDir = file("$outputDir/cache")
                cacheDir.mkdirs()
                def query = file("$outputDir/stub-query.fasta")
                query.text = ''
                def helper = file(projectDir + '/bin/msa_cache.py')
                def payload = file(projectDir + '/modules/local/msa_cache_lookup/tests/multimer.json')
                def a3mPayload = file("$outputDir/alignment.a3m")
                a3mPayload.text = '>query\nACDEFG\n'
                def command = ['python3', helper.toString(), 'store', query.toString(), 'revision', 'sha256:test-image', '', cacheDir.toString(), payload.toString(), a3mPayload.toString()]
                assert command.execute().waitFor() == 0
                assert cacheDir.listFiles().count { it.name.endsWith('.zip') } == 1
        }
        when {
            params {
                outdir = "$outputDir"
                boltz_msa_cache_dir = "$outputDir/cache"
                boltz_msa_cache_id = "revision"
                boltz_msa_cache_tool_id = "sha256:test-image"
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.succeeded().any { it.name.contains('MSA_CACHE_LOOKUP') }
            assert workflow.trace.succeeded().any { it.name.contains('SPLIT_MSA') }
            assert !workflow.trace.succeeded().any { it.name.contains('MMSEQS_COLABFOLDSEARCH') }
        }
    }

    test("-profile test_boltz") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // Early failure no need to test the rest of snapshots
            assert workflow.success
            assert file("${params.outdir}/multiqc/multiqc_report.html").exists(): "MultiQC report missing - the reporting channel went empty"
            assertAll(
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    // removed deprecated versions file reference
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }
}
