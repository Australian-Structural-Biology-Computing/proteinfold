nextflow_process {

    name "Test metrics are inserted properly by MODELCIF_ASSEMBLE_BATCH process"
    script "../modules/local/assemble_modelcif/main.nf"
    process "MODELCIF_ASSEMBLE_BATCH"
    tag "ci_img_misc"

    tag "assemble_modelcif"
    config "./assemble_modelcif_software.config"

    // Build the per-test input bundle: ranked structures named
    // <sample_id>_rank_<n>.cif (mmCIF content), the sample's a3m, and the
    // packed metric stores built from the legacy per-rank TSV fixtures by
    // tests/make_packed_store.py. Returns a nextflow expression string for
    // `input[0]`, because the nf-test DSL `file()` helper is only in scope
    // inside the generated test script.
    def buildInputs = { String outputDir, String projectDir, String sampleId, int storeRanks, Map opts = [:] ->
        def testdataBase = (System.getenv('PROTEINFOLD_TESTDATA_BASE_PATH') ?: 'https://raw.githubusercontent.com/Australian-Structural-Biology-Computing/test-datasets/refs/heads/proteinfold/')
        def structCount = opts.get('structs', storeRanks)
        if (opts.fetchRanked) {
            def sourceFile = File.createTempFile('DUMMY_MMCIF_rank_0', '.mmcif')
            sourceFile.bytes = new URL(testdataBase + 'testdata/models/DUMMY_MMCIF_rank_0.mmcif').bytes
            def generator = ['python3', "$projectDir/tests/generate_ranked_modelcif.py", sourceFile.absolutePath, "$outputDir/ranked"].execute()
            assert generator.waitFor() == 0 : generator.err.text
            sourceFile.delete()
        }
        (0..structCount - 1).each { rank ->
            if (opts.generated && rank > 0) {
                new File(outputDir, "${sampleId}_rank_${rank}.cif").bytes =
                    new File("$outputDir/ranked/DUMMY_MMCIF_rank_${rank}.mmcif").bytes
            } else {
                def source = opts.generated
                    ? new URL(testdataBase + 'testdata/models/DUMMY_MMCIF_rank_0.mmcif').bytes
                    : new URL(testdataBase + 'testdata/models/DUMMY_MODELCIF.mmcif').text
                new File(outputDir, "${sampleId}_rank_${rank}.cif").withOutputStream { os -> os << source }
            }
        }
        def plddtLines = new URL(testdataBase + 'testdata/metrics/DUMMY_PLDDT.tsv').readLines()
        (0..storeRanks - 1).each { rank ->
            def column = plddtLines[0].split('\t').findIndexOf { it == "rank_${rank}" }
            new File(outputDir, "${sampleId}_plddt_${rank}.tsv").text = plddtLines.tail()
                .collect { it.split('\t')[column] }.join('\n') + '\n'
        }
        (0..storeRanks - 1).each { rank ->
            def pae = new File(projectDir, 'tests/fixtures/DUMMY_PAE.tsv').text
            if (opts.distinctPae && rank > 0) {
                pae = pae.replaceFirst('0\\.2601', "${rank}.2601")
            }
            new File(outputDir, "${sampleId}_pae_${rank}.tsv").text = pae
        }
        // 20-residue single-sequence a3m matching the fixture structure
        new File(outputDir, "${sampleId}.a3m").text = ">${sampleId}\n" + ('A' * 20) + '\n'

        def plddtSpec = (0..storeRanks - 1).collect { "rank_${it}=${outputDir}/${sampleId}_plddt_${it}.tsv" }.join(',')
        def paeSpec = opts.withPae == false ? '' :
            (0..storeRanks - 1).collect { "rank_${it}=${outputDir}/${sampleId}_pae_${it}.tsv" }.join(',')
        def scoresSpec = (0..storeRanks - 1).collect { "rank_${it}=0.5" }.join(',')
        def generator = [
            'python3', "$projectDir/tests/make_packed_store.py",
            '--sample-id', sampleId,
            '--out-prefix', "$outputDir/${sampleId}",
            '--plddt', plddtSpec,
            '--pae', paeSpec,
            '--scores', scoresSpec
        ].execute()
        assert generator.waitFor() == 0 : generator.err.text

        def structs = (0..structCount - 1).collect { "file('${outputDir}/${sampleId}_rank_${it}.cif', checkIfExists: true)" }.join(', ')
        def stores = "file('${outputDir}/${sampleId}_metrics.jsonl.gz', checkIfExists: true), file('${outputDir}/${sampleId}_metrics.npz', checkIfExists: true)"
        "[[[id: '${sampleId}', model: 'alphafold2', msa_tool: 'jackhmmer']], [${structs}], [file('${outputDir}/${sampleId}.a3m', checkIfExists: true)], [${stores}], '${sampleId}\\t${sampleId}_metrics.jsonl.gz\\t${sampleId}_metrics.npz']"
    }

    def versionsInputCode = {
        "file(\"${System.getenv('PROTEINFOLD_TESTDATA_BASE_PATH') ?: 'https://raw.githubusercontent.com/Australian-Structural-Biology-Computing/test-datasets/refs/heads/proteinfold/'}testdata/metrics/DUMMY_SOFTWARE_VERSIONS.yml\", checkIfExists: true)"
    }

    def assertModelcifOutput = { proc, modelcifPath, expectEmbeddedPAE, expectBinaryCIF ->
        assert proc.success
        assert proc.out.modelcif.size() == 1
        assert path(proc.out.versions[0]).getFileName().toString() == 'versions.yml'

        def outName = modelcifPath.getFileName().toString()
        if (expectBinaryCIF) {
            assert outName.endsWith('.bcif')
            assert modelcifPath.bytes.length > 0

            return
        }

        def mmcif = modelcifPath.text
        assertAll(
            { assert outName.endsWith('.mmcif') },
            { assert mmcif.contains("_ma_qa_metric_local"),
                "pLDDT qa_metric table missing from output mmCIF" },

            { assert mmcif.contains("_ma_qa_metric_global"),
                "Global qa_metric table (pTM/ipTM) missing from output mmCIF" },

            { assert mmcif.contains("pTM"),
                "pTM metric type missing from output mmCIF" },

            { assert mmcif.contains("ipTM"),
                "ipTM metric type missing from output mmCIF" },

            {
                if (expectEmbeddedPAE) {
                    assert mmcif.contains("_ma_qa_metric_local_pairwise")
                } else {
                    assert mmcif.contains("_ma_entry_associated_files")
                }
            },

            {
                if (expectEmbeddedPAE) {
                    assert mmcif.contains("PAE")
                } else {
                    assert (mmcif =~ /\S+\.npz[^\n]*file other other/).find()
                }
            },

            { assert mmcif.contains("coevolution MSA"),
                "Coevolution MSA protocol step missing from output mmCIF" },

            { assert mmcif.contains("modeling"),
                "Modeling protocol step missing from output mmCIF" }
        )
    }

    test("dummy inputs produce modelcif with associated PAE") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def inputs = buildInputs(outputDir, projectDir, 'test', 2)
                """
                input[0] = ${inputs}
                input[1] = ${versionsInputCode()}
                input[2] = 'cif'
                input[3] = file("$projectDir/assets/modelcif_software_details.yml", checkIfExists: true)
                """
            }
        }
        then {
            assert snapshot(process.out).match()
            assert process.success
            def outputFile = path(process.out.modelcif[0][1])
            assert outputFile.text.contains('_ma_qa_metric')
            assert outputFile.text.contains('_ma_protocol_step')
            // One packed PAE store per sample; every rank's model
            // associates it as its PAE source instead of per-rank TSVs.
            def packedPath = "pae/test_pae.npz"
            assert outputFile.text.contains("model ${packedPath} file other other")
            assert java.nio.file.Files.isRegularFile(outputFile.parent.resolve(packedPath))
            // nf-test unwraps single-file emits to the bare path
            def paeFiles = [process.out.pae[0]].flatten()
            assert paeFiles.size() == 1
            assert paeFiles[0].toString().contains('pae/test_pae.npz')
            assert path(process.out.versions[0]).getFileName().toString() == 'versions.yml'
            assert outputFile.text.contains('nf-core/proteinfold')
            assert outputFile.text.contains('2.3.2')
        }
    }

    test("dummy inputs produce modelcif with embedded PAE") {
        config "./assemble_modelcif_embed.config"

        when {
            process {
                def inputs = buildInputs(outputDir, projectDir, 'test_embed', 2, [distinctPae: true])
                """
                input[0] = ${inputs}
                input[1] = ${versionsInputCode()}
                input[2] = 'cif'
                input[3] = file("$projectDir/assets/modelcif_software_details.yml", checkIfExists: true)
                """
            }
        }
        then {
            assert snapshot(process.out).match()
            assert process.success
            def outputFile = path(process.out.modelcif[0][1])
            assert outputFile.text.contains('_ma_qa_metric_local_pairwise')
            assert outputFile.text.contains('1.260')
            assert !outputFile.text.contains('_ma_entry_associated_files')
            assert path(process.out.versions[0]).getFileName().toString() == 'versions.yml'
        }
    }

    test("rejects a mismatch between structures and pLDDT ranks") {
        when {
            process {
                // The packed store carries pLDDT for two ranks but only one
                // ranked structure is present.
                def inputs = buildInputs(outputDir, projectDir, 'test_mismatch', 2, [structs: 1])
                """
                input[0] = ${inputs}
                input[1] = ${versionsInputCode()}
                input[2] = 'cif'
                input[3] = file("$projectDir/assets/modelcif_software_details.yml", checkIfExists: true)
                """
            }
        }

        then {
            assert process.failed
        }
    }

    test("dummy inputs produce binaryCIF") {
        config "./assemble_modelcif_binary.config"

        when {
            process {
                def inputs = buildInputs(outputDir, projectDir, 'test_binary', 1)
                """
                input[0] = ${inputs}
                input[1] = ${versionsInputCode()}
                input[2] = 'cif'
                input[3] = file("$projectDir/assets/modelcif_software_details.yml", checkIfExists: true)
                """
            }
        }

        then {
            assert snapshot(process.out).match()
            def modelcifPath = path(process.out.modelcif[0][1])
            assertModelcifOutput(process, modelcifPath, false, true)
        }
    }

    test("dummy inputs include all ranked models by default") {
        when {
            process {
                def inputs = buildInputs(outputDir, projectDir, 'test_multi_default', 5, [structs: 5, generated: true, fetchRanked: true])
                """
                input[0] = ${inputs}
                input[1] = ${versionsInputCode()}
                input[2] = 'cif'
                input[3] = file("$projectDir/assets/modelcif_software_details.yml", checkIfExists: true)
                """
            }
        }

        then {
            assert snapshot(process.out).match()
            def modelcifPath = path(process.out.modelcif[0][1])
            assertModelcifOutput(process, modelcifPath, false, false)

            def mmcif = modelcifPath.text
            assertAll(
                { assert mmcif.contains("test_multi_default rank_0") },
                { assert mmcif.contains("test_multi_default rank_1") },
                { assert mmcif.contains("test_multi_default rank_2") },
                { assert mmcif.contains("test_multi_default rank_3") },
                { assert mmcif.contains("test_multi_default rank_4") }
            )
            assert process.out.versions.size() == 1
        }
    }

    test("dummy inputs produce modelcif from five mmcif structures") {
        when {
            process {
                def inputs = buildInputs(outputDir, projectDir, 'test_multi', 5, [structs: 5, generated: true, fetchRanked: true])
                """
                input[0] = ${inputs}
                input[1] = ${versionsInputCode()}
                input[2] = 'cif'
                input[3] = file("$projectDir/assets/modelcif_software_details.yml", checkIfExists: true)
                """
            }
        }

        then {
            assert snapshot(process.out).match()
            def modelcifPath = path(process.out.modelcif[0][1])
            assertModelcifOutput(process, modelcifPath, false, false)

            def mmcif = modelcifPath.text
            assertAll(
                { assert mmcif.contains("test_multi rank_0") },
                { assert mmcif.contains("test_multi rank_1") },
                { assert mmcif.contains("test_multi rank_2") },
                { assert mmcif.contains("test_multi rank_3") },
                { assert mmcif.contains("test_multi rank_4") }
            )
            assert process.out.versions.size() == 1
        }
    }

    test("pLDDT metric type follows --plddt-scale") {
        config "./assemble_modelcif_plddt_scale.config"

        when {
            process {
                def inputs = buildInputs(outputDir, projectDir, 'test_scale', 5, [withPae: false])
                """
                input[0] = ${inputs}
                input[1] = ${versionsInputCode()}
                input[2] = 'cif'
                input[3] = file("$projectDir/assets/modelcif_software_details.yml", checkIfExists: true)
                """
            }
        }

        then {
            assert snapshot(process.out).match()
            def mmcif = path(process.out.modelcif[0][1]).text
            assertAll(
                { assert mmcif.contains("'pLDDT in [0,1]' local") },
                { assert !mmcif.contains("'pLDDT-CA'") }
            )
            assert process.out.versions.size() == 1
        }
    }

    test("--seed tsv attaches container and seed software parameters") {
        config "./assemble_modelcif_seed.config"

        when {
            process {
                def inputs = buildInputs(outputDir, projectDir, 'test_seed', 5, [withPae: false])
                """
                input[0] = ${inputs}
                input[1] = ${versionsInputCode()}
                input[2] = 'cif'
                input[3] = file("$projectDir/assets/modelcif_software_details.yml", checkIfExists: true)
                """
            }
        }

        then {
            assert snapshot(process.out).match()
            def mmcif = path(process.out.modelcif[0][1]).text
            assertAll(
                { assert mmcif.contains("_ma_software_parameter") },
                { assert mmcif.contains("integer seed 0") }
            )
            assert process.out.versions.size() == 1
        }
    }

    test("chainwise metrics are skipped for monomer inputs") {
        when {
            process {
                // No chainwise records in the store, so no chainwise QA
                // metrics may appear even though the flag group exists.
                def inputs = buildInputs(outputDir, projectDir, 'test_cw', 5, [withPae: false])
                """
                input[0] = ${inputs}
                input[1] = ${versionsInputCode()}
                input[2] = 'cif'
                input[3] = file("$projectDir/assets/modelcif_software_details.yml", checkIfExists: true)
                """
            }
        }

        then {
            assert snapshot(process.out).match()
            def mmcif = path(process.out.modelcif[0][1]).text
            assertAll(
                { assert !mmcif.contains("_ma_qa_metric_feature") },
                { assert mmcif.contains("LocalPLDDT") }
            )
            assert process.out.versions.size() == 1
        }
    }

    test("template search step is attributed to its own tool") {
        when {
            process {
                def inputs = buildInputs(outputDir, projectDir, 'test_tpl', 5, [withPae: false])
                """
                input[0] = ${inputs}
                input[1] = ${versionsInputCode()}
                input[2] = 'cif'
                input[3] = file("$projectDir/assets/modelcif_software_details.yml", checkIfExists: true)
                """
            }
        }

        then {
            assert snapshot(process.out).match()
            def mmcif = path(process.out.modelcif[0][1]).text
            assertAll(
                { assert mmcif.contains("'template search'") },
                { assert mmcif.contains("HHsearch") },
                // the template step must not be lumped in with the modeling software
                { assert mmcif.contains("'coevolution MSA'") }
            )
            assert process.out.versions.size() == 1
        }
    }

}
