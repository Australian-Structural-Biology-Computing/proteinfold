nextflow_process {

    name "Test Process MODELCIF_SW_ENTRIES"
    script "../modules/local/assemble_modelcif/main.nf"
    process "MODELCIF_ASSEMBLE_BATCH"

    tag "modelcif_sw_entries"
    tag "ci_img_misc"
    config "./assemble_modelcif_software.config"

    test("dummy inputs include model software and software groups") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def testdataBase = (System.getenv('PROTEINFOLD_TESTDATA_BASE_PATH') ?: 'https://raw.githubusercontent.com/Australian-Structural-Biology-Computing/test-datasets/refs/heads/proteinfold/')
                new File(outputDir, 'sw_entries_rank_0.cif').text =
                    new URL(testdataBase + 'testdata/models/DUMMY_MODELCIF.mmcif').text
                new File(outputDir, 'sw_entries_plddt_0.tsv').text = new URL(testdataBase + 'testdata/metrics/DUMMY_PLDDT.tsv').readLines()
                    .tail().collect { it.split('\t')[1] }.join('\n') + '\n'
                new File(outputDir, 'sw_entries_pae_0.tsv').text = new File(projectDir, 'tests/fixtures/DUMMY_PAE.tsv').text
                // single-sequence a3m matching the fixture structure
                new File(outputDir, 'sw_entries.a3m').text = '>sw_entries\n' + ('A' * 20) + '\n'
                def generator = [
                    'python3', "$projectDir/tests/make_packed_store.py",
                    '--sample-id', 'sw_entries',
                    '--out-prefix', "$outputDir/sw_entries",
                    '--plddt', "rank_0=$outputDir/sw_entries_plddt_0.tsv",
                    '--pae', "rank_0=$outputDir/sw_entries_pae_0.tsv",
                    '--scores', 'rank_0=0.5'
                ].execute()
                assert generator.waitFor() == 0 : generator.err.text
                """
                input[0] = [
                    [[ id: 'sw_entries', model: 'alphafold2', msa_tool: 'jackhmmer', no_template_search: true ]],
                    [file("$outputDir/sw_entries_rank_0.cif", checkIfExists: true)],
                    [file("$outputDir/sw_entries.a3m", checkIfExists: true)],
                    [file("$outputDir/sw_entries_metrics.jsonl.gz", checkIfExists: true), file("$outputDir/sw_entries_metrics.npz", checkIfExists: true)],
                    'sw_entries\tsw_entries_metrics.jsonl.gz\tsw_entries_metrics.npz'
                ]
                input[1] = file("${testdataBase}testdata/metrics/DUMMY_SOFTWARE_VERSIONS.yml", checkIfExists: true)
                input[2] = 'cif'
                input[3] = file("$projectDir/assets/modelcif_software_details.yml", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
            assert process.out.modelcif.size() == 1
            def modelcifPath = path(process.out.modelcif[0][1])
            def mmcif = modelcifPath.text
            assert mmcif.contains('AlphaFold2')
            assert mmcif.contains('nf-core/proteinfold')
            assert mmcif.contains('jackhmmer')
            assert mmcif.contains('coevolution MSA')
            assert mmcif.contains('modeling')
            assert mmcif.contains('_ma_protocol_step')
            assert path(process.out.versions[0]).getFileName().toString() == 'versions.yml'

        }
    }
}
