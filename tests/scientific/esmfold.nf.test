nextflow_pipeline {

    name "Scientific validation: ESMFold"
    script "../../main.nf"
    tag "scientific"
    tag "gpu"
    tag "real"
    tag "esmfold"
    profile "test_full_esmfold,gpu"

    test("ESMFold: validate structures and metrics") {
        options "--mode esmfold --use_gpu"

        when {
            params {
                input     = file("${projectDir}/tests/fixtures/samplesheet.csv", checkIfExists: true)
                outdir    = "$outputDir"
                esmfold_db = System.getenv("PROTEINFOLD_TEST_DB")
            }
        }

        then {
            assert params.esmfold_db: "Set PROTEINFOLD_TEST_DB to the local ProteinFold microDB root"
            assert workflow.success: "ESMFold workflow failed (exit ${workflow.exitStatus})"
            def validator = new File("tests/scientific/validate_outputs.py").absolutePath
            def command = ["python3", validator, "--mode", "esmfold", "--display-name", "ESMFold",
                           "--extension", ".pdb", "--outdir", params.outdir.toString(),
                           "--samplesheet", params.input.toString()]
            def process = command.execute()
            def stdout = new StringBuffer()
            def stderr = new StringBuffer()
            process.consumeProcessOutput(stdout, stderr)
            assert process.waitFor() == 0: "${stdout}\n${stderr}"
            println stdout
            assert file("${params.outdir}/pipeline_info/nf_core_proteinfold_software_mqc_versions.yml").size() > 0
        }
    }
}
