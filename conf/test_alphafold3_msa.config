/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the alphafold3_msa MSA tool test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Runs the unified pipeline with --msa_tool alphafold3_msa against dummy
    databases with stubbed processes, to verify orchestration and wiring.
        nextflow run . -profile test_alphafold3_msa -stub-run
----------------------------------------------------------------------------------------
*/

stubRun = true

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'alphafold3_msa MSA tool stub test'
    config_profile_description = 'Minimal test of the unified pipeline with the alphafold3_msa MSA module'
    mode                       = 'alphafold3'
    msa_tool                   = 'alphafold3_msa'
    alphafold3_db              = "${projectDir}/assets/dummy_db_dir"
    colabfold2_params_path     = "${projectDir}/assets/dummy_db_dir"
    input                      = params.pipelines_testdata_base_path + 'proteinfold/testdata/samplesheet/v2.0/samplesheet.csv'
}
