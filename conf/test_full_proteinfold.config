
params {
    config_profile_name        = 'Full test profile for proteinfold'
    config_profile_description = 'Full test dataset to check the proteinfold prediction modes'
    mode                       = 'opendde'
    use_gpu                    = true
    input                      = params.pipelines_testdata_base_path + 'proteinfold/testdata/samplesheet/v2.0/samplesheet.csv'
    colabfold_db               = 's3://proteinfold-dataset/test-data/mini_dbs'
}

process {
    executor = 'local'
    withName: 'MMSEQS_COLABFOLDSEARCH' {
        cpus   = 4
        memory = 15.GB
    }
    withName: '.*COLABFOLD2:(ALPHAFOLD2|ALPHAFOLD3|BOLTZ2|OPENFOLD3|OPENBIND0|PROTEINX2|CHAI1|INTELLIFOLD2|OPENDDE|ROSETTAFOLD3|ESMFOLD2)' {
        cpus   = 4
        memory = 60.GB
        time   = '4.h'
    }
}
