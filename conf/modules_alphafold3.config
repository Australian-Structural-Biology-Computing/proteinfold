/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

//
// General configuration options
//

process {
    withName: 'GUNZIP' {
        publishDir = [
            path: {"${params.outdir}/DBs/alphafold3/"},
            mode: 'symlink',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'ZSTD_DECOMPRESS' {
        ext.args = '--force'
        publishDir = [
            [
                path: {"${params.outdir}/DBs/${params.msa_tool}/mgnify"},
                mode: 'symlink',
                pattern: 'mgy_clusters_2022_05.fa'
            ],
            [
                path: {"${params.outdir}/DBs/${params.msa_tool}/pdb_seqres"},
                mode: 'symlink',
                pattern: 'pdb_seqres_*.fasta'
            ],
            [
                path: {"${params.outdir}/DBs/${params.msa_tool}/small_bfd"},
                mode: 'symlink',
                pattern: 'bfd-first_non_consensus_sequences.fasta'
            ],
            [
                path: {"${params.outdir}/DBs/${params.msa_tool}/uniprot"},
                mode: 'symlink',
                pattern: 'uniprot*.fa'
            ],
            [
                path: {"${params.outdir}/DBs/${params.msa_tool}/uniref90"},
                mode: 'symlink',
                pattern: 'uniref90*.fa'
            ],
            [
                path: {"${params.outdir}/DBs/${params.msa_tool}/rnacentral"},
                mode: 'symlink',
                pattern: 'rnacentral*.fasta'
            ],
            [
                path: {"${params.outdir}/DBs/${params.msa_tool}/nt_rna"},
                mode: 'symlink',
                pattern: 'nt_rna*.fasta'
            ],
            [
                path: {"${params.outdir}/DBs/${params.msa_tool}/rfam"},
                mode: 'symlink',
                pattern: 'rfam*.fasta'
            ],
        ]
    }
    withName: '.*PREPARE_ALPHAFOLD3_DBS:ARIA2_MMCIF:UNTAR' {
        publishDir = [
            path: { "${params.outdir}/DBs/${params.msa_tool}/pdb_mmcif" },
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null
                }
                return filename.replaceAll(/.*_mmcif_files/, 'mmcif_files')
            },
        ]
    }
}

//
// Module specific configuration options
//
process {
    withName: 'RUN_ALPHAFOLD3_DATAPIPELINE' {
        publishDir = [
            [
                // Always publish the data JSON — it is the reusable MSA artifact
                // that allows inference to be re-run without repeating the data pipeline
                path: { "${params.outdir}/msa/${meta.id}_${[ 'colabfold_search': 'mmseqs', 'alphafold2_msa': 'af2msa', 'alphafold3_msa': 'af3msa' ].get(params.msa_tool, 'server')}" },
                mode: 'copy',
                pattern: '*_data.json'
            ]
        ]
    }
}
