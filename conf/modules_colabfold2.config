
process {
    withName: 'COLABFOLD2_INFERENCE|COLABFOLD2_INFERENCE_BATCH' {
        accelerator = { params.use_gpu ? 1 : 0 }
        ext.args = {
            def args = params.use_msa_server && params.msa_server_url ? "--host-url ${params.msa_server_url}" : ''
            if (params.colabfold2_kernel_backend && params.colabfold2_kernel_backend != 'auto') {
                args = "${args} --use-fast-kernels --kernel-backend ${params.colabfold2_kernel_backend}".trim()
            }
            args
        }
        ext.weights_precision = { params.colabfold2_weights_precision }
    }

    withName: 'COLABFOLD2_INFERENCE' {
        publishDir = [
            [
                path: { "${params.outdir}/${public_mode}/${meta.id}" },
                mode: 'copy',
                saveAs: { filename ->
                    if (filename.endsWith('_pae.tsv')) {
                        "paes/$filename"
                    } else {
                        filename
                    }
                },
                pattern: '*.tsv'
            ],
            [
                enabled: params.save_intermediates,
                path: { "${params.outdir}/${public_mode}/${meta.id}" },
                mode: 'copy',
                pattern: 'raw/**'
            ],
            [
                path: { "${params.outdir}/${public_mode}/top_ranked_structures" },
                mode: 'copy',
                saveAs: { filename -> def m = (filename =~ /(.+)_colabfold2\.([A-Za-z0-9]+)$/); m ? "${m[0][1]}.${m[0][2]}" : filename },
                pattern: '*_colabfold2.*'
            ]
        ]
    }

    // Batched inference covers several samples per task, so outputs publish
    // flat under the public mode token (files are named per sample).
    withName: 'COLABFOLD2_INFERENCE_BATCH' {
        publishDir = [
            [
                path: { "${params.outdir}/${public_mode}" },
                mode: 'copy',
                saveAs: { filename -> filename.endsWith('_pae.tsv') ? "paes/$filename" : filename },
                pattern: '*.tsv'
            ],
            [
                enabled: params.save_intermediates,
                path: { "${params.outdir}/${public_mode}" },
                mode: 'copy',
                pattern: 'raw/**'
            ],
            [
                path: { "${params.outdir}/${public_mode}/top_ranked_structures" },
                mode: 'copy',
                saveAs: { filename -> def m = (filename =~ /(.+)_colabfold2\.([A-Za-z0-9]+)$/); m ? "${m[0][1]}.${m[0][2]}" : filename },
                pattern: '*_colabfold2.*'
            ]
        ]
    }
}
