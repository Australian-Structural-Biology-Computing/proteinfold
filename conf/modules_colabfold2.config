
process {
    withName: 'COLABFOLD2_INFERENCE_BATCH' {
        accelerator = { params.use_gpu ? 1 : 0 }
        ext.args = {
            def args = params.use_msa_server && params.msa_server_url ? "--host-url ${params.msa_server_url}" : ''
            if (params.colabfold2_kernel_backend && params.colabfold2_kernel_backend != 'auto') {
                args = "${args} --use-fast-kernels --kernel-backend ${params.colabfold2_kernel_backend}".trim()
            }
            if (params.colabfold2_compile_cache) {
                args = "${args} --compile-cache ${params.colabfold2_compile_cache}".trim()
            }
            args
        }
        ext.weights_precision = { params.colabfold2_weights_precision }

        // Flat layout: the mode and MSA-source shorthands are baked into every
        // published file name, so no per-mode directory nesting is needed.
        // colabfold_batch names each output after the sanitised sample id, so
        // the publishing sample is looked up from the batch's metadata list
        // (longest sanitised id first: ids may be prefixes of one another).
        publishDir = [
            [
                enabled: params.save_intermediates,
                path: { "${params.outdir}/raw" },
                mode: 'copy',
                pattern: 'raw/**',
                saveAs: { filename -> filename.replaceFirst(/^raw\//, '') }
            ],
            [
                enabled: params.save_intermediates,
                path: { "${params.outdir}/metrics" },
                mode: 'copy',
                saveAs: { filename ->
                    def m = (filename =~ /_colabfold2_metrics\.(jsonl\.gz|npz)$/)
                    if (!m) {
                        return filename
                    }
                    def head = batch_meta instanceof List ? batch_meta[0] : batch_meta
                    "${head.id}_${head.mode_short}_${head.msa_short}_metrics.${m[0][1]}"
                },
                pattern: '*_colabfold2_metrics.{jsonl.gz,npz}'
            ],
            [
                path: { "${params.outdir}/top_ranked_structures" },
                mode: 'copy',
                saveAs: { filename ->
                    def m = (filename =~ /_colabfold2\.([A-Za-z0-9]+)$/)
                    if (!m) {
                        return filename
                    }
                    def sample = batch_meta.sort { -((it.id as String).replaceAll(/[^A-Za-z0-9_.-]/, '_').length()) }
                        .find { mm -> filename.startsWith(((mm.id as String).replaceAll(/[^A-Za-z0-9_.-]/, '_')) + '_') }
                    sample == null ? filename : "${sample.id}_${sample.mode_short}_${sample.msa_short}.${m[0][1]}"
                },
                pattern: '*_colabfold2.*'
            ]
        ]
    }
}
