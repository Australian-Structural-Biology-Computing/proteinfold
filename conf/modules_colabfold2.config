
process {
    withName: 'COLABFOLD2_INFERENCE' {
        accelerator = { params.use_gpu ? 1 : 0 }
        ext.args = {
            def args = params.use_msa_server && params.msa_server_url ? "--host-url ${params.msa_server_url}" : ''
            if (params.colabfold2_kernel_backend && params.colabfold2_kernel_backend != 'auto') {
                args = "${args} --use-fast-kernels --kernel-backend ${params.colabfold2_kernel_backend}".trim()
            }
            if (params.colabfold2_compile_cache) {
                args = "${args} --compile-cache ${params.colabfold2_compile_cache}".trim()
            }
            args
        }
        ext.weights_precision = { params.colabfold2_weights_precision }
        // Flat layout: the mode shorthand is baked into every file name, so
        // no per-mode directory nesting is needed.
        publishDir = [
            [
                path: { "${params.outdir}/metrics" },
                mode: 'copy',
                saveAs: { filename ->
                    if (!filename.startsWith("${meta.id}_")) {
                        return filename
                    }
                    def rest = filename.substring("${meta.id}_".length())
                    if (rest == 'colabfold2_msa.tsv') {
                        return "${meta.id}_${meta.mode_short}_${meta.msa_short}_msa.tsv"
                    }
                    "${meta.id}_${meta.mode_short}_${meta.msa_short}_${rest}"
                },
                pattern: '*.tsv'
            ],
            [
                enabled: params.save_intermediates,
                path: { "${params.outdir}/raw" },
                mode: 'copy',
                pattern: 'raw/**',
                saveAs: { filename -> filename.replaceFirst(/^raw\//, '') }
            ],
            [
                path: { "${params.outdir}/top_ranked_structures" },
                mode: 'copy',
                saveAs: { filename -> def m = (filename =~ /_colabfold2\.([A-Za-z0-9]+)$/); m ? "${meta.id}_${meta.mode_short}_${meta.msa_short}.${m[0][1]}" : filename },
                pattern: '*_colabfold2.*'
            ]
        ]
    }
}
