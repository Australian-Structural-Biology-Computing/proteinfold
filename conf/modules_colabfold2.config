
process {
    withName: 'COLABFOLD2_INFERENCE|COLABFOLD2_INFERENCE_BATCH' {
        accelerator = { params.use_gpu ? 1 : 0 }
        ext.args = {
            def args = params.use_msa_server && params.msa_server_url ? "--host-url ${params.msa_server_url}" : ''
            if (params.colabfold2_kernel_backend && params.colabfold2_kernel_backend != 'auto') {
                args = "${args} --use-fast-kernels --kernel-backend ${params.colabfold2_kernel_backend}".trim()
            }
            if (params.colabfold2_compile_cache) {
                args = "${args} --compile-cache ${params.colabfold2_compile_cache}".trim()
            }
            args
        }
        ext.weights_precision = { params.colabfold2_weights_precision }
    }

    withName: 'COLABFOLD2_INFERENCE' {
        // Flat layout: the mode shorthand is baked into every file name, so
        // no per-mode directory nesting is needed.
        publishDir = [
            [
                path: { "${params.outdir}/metrics" },
                mode: 'copy',
                saveAs: { filename ->
                    if (!filename.startsWith("${meta.id}_")) {
                        return filename
                    }
                    def rest = filename.substring("${meta.id}_".length())
                    if (rest == 'colabfold2_msa.tsv') {
                        return "${meta.id}_${meta.mode_short}_${meta.msa_short}_msa.tsv"
                    }
                    "${meta.id}_${meta.mode_short}_${meta.msa_short}_${rest}"
                },
                pattern: '*.tsv'
            ],
            [
                enabled: params.save_intermediates,
                path: { "${params.outdir}/raw" },
                mode: 'copy',
                pattern: 'raw/**',
                saveAs: { filename -> filename.replaceFirst(/^raw\//, '') }
            ],
            [
                path: { "${params.outdir}/top_ranked_structures" },
                mode: 'copy',
                saveAs: { filename -> def m = (filename =~ /_colabfold2\.([A-Za-z0-9]+)$/); m ? "${meta.id}_${meta.mode_short}_${meta.msa_short}.${m[0][1]}" : filename },
                pattern: '*_colabfold2.*'
            ]
        ]
    }

    // Batched inference publishes the same flat layout. colabfold_batch names
    // every output after its sample id, so the publishing sample is looked up
    // from the batch's metadata list (longest id first: ids may be prefixes of
    // one another).
    withName: 'COLABFOLD2_INFERENCE_BATCH' {
        publishDir = [
            [
                path: { "${params.outdir}/metrics" },
                mode: 'copy',
                saveAs: { filename ->
                    def sample = batch_meta.sort { -((it.id as String).length()) }.find { m -> filename.startsWith("${m.id}_") }
                    if (sample == null) {
                        return filename
                    }
                    def rest = filename.substring("${sample.id}_".length())
                    if (rest == 'colabfold2_msa.tsv') {
                        return "${sample.id}_${sample.mode_short}_${sample.msa_short}_msa.tsv"
                    }
                    "${sample.id}_${sample.mode_short}_${sample.msa_short}_${rest}"
                },
                pattern: '*.tsv'
            ],
            [
                enabled: params.save_intermediates,
                path: { "${params.outdir}/raw" },
                mode: 'copy',
                pattern: 'raw/**',
                saveAs: { filename -> filename.replaceFirst(/^raw\//, '') }
            ],
            [
                path: { "${params.outdir}/top_ranked_structures" },
                mode: 'copy',
                saveAs: { filename ->
                    def m = (filename =~ /_colabfold2\.([A-Za-z0-9]+)$/)
                    if (!m) {
                        return filename
                    }
                    def sample = batch_meta.sort { -((it.id as String).length()) }.find { mm -> filename.startsWith("${mm.id}_") }
                    sample == null ? filename : "${sample.id}_${sample.mode_short}_${sample.msa_short}.${m[0][1]}"
                },
                pattern: '*_colabfold2.*'
            ]
        ]
    }
}
