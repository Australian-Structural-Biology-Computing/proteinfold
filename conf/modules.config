/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

//
// General configuration options
//

process {
    withName: 'MODELCIF_ASSEMBLE' {
        ext.args = {
            [
                params.modelcif_binary ? '--write_binary' : '',
                params.modelcif_pae_embed ? '--pae-embed' : '',
                params.modelcif_software_details ? "--software_details '${params.modelcif_software_details}'" : '',
            ].findAll { arg -> arg }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/modelcif" },
            mode: params.publish_dir_mode,
            pattern: 'pae/*_pae.tsv'
        ]
    }

    withName: 'CIFCHECK' {
        publishDir = [
            path: { "${params.outdir}/modelcif" },
            mode: params.publish_dir_mode,
            pattern: '*.{mmcif,bcif}'
        ]
    }

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]
}

//
// DBs and parameters preparation options
//

process {
    withName: 'UNTAR' {
        ext.args2 = '--no-same-owner'
        publishDir = [
            path: {"${params.outdir}/DBs/colabfold2"},
            mode: 'symlink',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'ARIA2' {
        time   = { 20.h  * task.attempt }
        publishDir = [
            enabled: false
        ]
    }

    // The model weights are multi-gigabyte re-derivable intermediates that
    // inference stages from the task work directory; they do not belong in
    // the run outputs. Point --colabfold2_params_path (or a local
    // <colabfold_db>/colabfold2_models cache) at a persistent location to
    // avoid re-downloading them per run.
    withName: 'DOWNLOAD_COLABFOLD2_WEIGHTS|DOWNLOAD_COLABFOLD2_AF2_WEIGHTS' {
        publishDir = [enabled: false]
    }

    withName: 'MULTIQC' {
        ext.prefix = { "${meta.model}_multiqc_report" }
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    // The custom-content JSON files are intermediates consumed by MULTIQC,
    // which copies them into multiqc_data in real runs; the catch-all
    // publishDir below would otherwise publish them again under generate/.
    withName: 'GENERATE_MULTIQC_CONTENTS' {
        publishDir = [
            enabled: false
        ]
    }

    withName: 'GENERATE_REPORT' {
        publishDir = [
            path: { "${params.outdir}/reports" },
            mode: 'copy',
            pattern: '*report.html'
        ]
    }

    // Internal adaptors between the MSA tools and the prediction backends;
    // their outputs are intermediates consumed by the inference task and are
    // re-derivable from the published MSA results.
    withName: 'TO_COLABFOLD_FASTA|ALPHAFOLD3_JSON_TO_AF2_FASTA|ALPHAFOLD3_JSON_TO_COLABFOLD_A3M|MERGE_ALPHAFOLD3_MSA|AF2_MSA_TO_COLABFOLD_JSON' {
        publishDir = [
            enabled: false
        ]
    }
}
